NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://deliveria:deliveria@127.0.0.1:5433/deliveria
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
OTP_PEPPER=replace-with-a-long-random-string
ENABLE_DEV_TOOLS=true
DEV_TOOLS_KEY=deliveria-dev
PUBLIC_BASE_URL=http://10.0.2.2:3000
# Firebase service-account JSON for external phone notifications. Do not commit the file.
FIREBASE_SERVICE_ACCOUNT=secrets/firebase-service-account.json
# Server key only, restricted to Routes API and Distance Matrix by IP.
# Do not put the Android app key here. Leave empty until a server key exists.
GOOGLE_MAPS_API_KEY=
